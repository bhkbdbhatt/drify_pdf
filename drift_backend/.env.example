# LLM providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Database (SQLite for dev, Postgres-ready)
# e.g. postgresql+psycopg://user:pass@localhost:5432/drift
DATABASE_URL=sqlite:///./drift.db

# LLM behaviour
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_INTER_RUN_DELAY=1.0

# Storage / limits
UPLOADS_DIR=uploads
MAX_DOCUMENT_CHARS=60000

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Drift thresholds
STABLE_CONSISTENCY_THRESHOLD=0.95
DRIFT_CONSISTENCY_THRESHOLD=0.5
NUMERIC_RELATIVE_TOLERANCE=0.01
MAX_UNIQUE_VALUES=25
